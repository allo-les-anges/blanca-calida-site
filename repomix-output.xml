                  }}
                  className={`block w-full px-4 py-2 text-sm text-left hover:bg-slate-100 dark:hover:bg-slate-800 ${
                    currentLang === lang.code ? 'text-[#D4AF37] font-bold' : 'text-slate-700 dark:text-slate-300'
