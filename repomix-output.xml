                      <option value="super_admin" className="bg-[#0F172A]">{t('adminStaff.superAdmin')}</option>
                  </select>
                  <ChevronRight size={18} className="absolute right-5 top-1/2 -translate-y-1/2 text-blue-500 rotate-90 pointer-events-none" />
