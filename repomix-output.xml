      {/* --- MODAL : AJOUT STAFF (AVEC RÔLE) --- */}
      {showStaffModal && (
        <div className="fixed inset-0 z-50 bg-black/95 backdrop-blur-3xl flex items-center justify-center p-4 lg:p-6 animate-in fade-in duration-500">
